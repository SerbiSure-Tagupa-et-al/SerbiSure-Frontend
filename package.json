{
  "name": "serbisure-frontend",
  "version": "2.1.4",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "test:support": "node --test tests/support-contacts.test.cjs",
    "test:profile": "node --test tests/profile-status.test.cjs",
    "test:cancellation": "node --test tests/booking-cancellation.test.cjs",
    "test:posting": "node --test tests/posting-restrictions.test.cjs",
    "test:session": "node --test tests/remember-session.test.cjs",
    "test:registration": "node --test tests/registration.test.cjs",
    "test:realtime": "node --test tests/chat-realtime.test.cjs tests/chat-session.test.cjs",
    "test:verification": "node --test tests/selfie-upload.test.cjs tests/liveness-flow.test.cjs tests/liveness-resilience.test.cjs tests/selfie-quality-adapter.test.cjs tests/mediapipe-patch.test.cjs",
    "test:localization": "node --test tests/localization.test.cjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build.ps1",
    "build:all": "npx eas-cli build --platform all",
    "build:ios": "npx eas-cli build --platform ios",
    "build:android": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build.ps1",
    "build:android:eas": "npx eas-cli build --platform android --profile preview",
    "build:preview": "npx eas-cli build --platform all --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:simulator:ios": "npx eas-cli build --platform ios --profile preview:simulator",
    "build:android:local": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build.ps1",
    "build:android:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build-debug.ps1",
    "android:build": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build.ps1",
    "android:build:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build-debug.ps1",
    "typecheck": "tsc --noEmit",
    "test:modules": "node --test tests/feature-modules.test.cjs",
    "postinstall": "node scripts/patch-mediapipe.js",
    "test": "node scripts/run-tests.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@shopify/react-native-skia": "^1.5.0",
    "expo": "^51.0.0",
    "expo-application": "~5.9.1",
    "expo-blur": "~13.0.3",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "^4.0.0",
    "expo-device": "~6.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-intent-launcher": "~11.0.1",
    "expo-notifications": "^0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "^1.12.1",
    "expo-updates": "~0.25.28",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-mediapipe": "^0.6.0",
    "react-native-qrcode-svg": "^6.3.49",
    "react-native-reanimated": "3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0",
    "react-native-vision-camera": "4.5.0",
    "react-native-vision-camera-face-detector": "1.10.2",
    "react-native-worklets-core": "^1.3.3",
    "text-encoding": "^0.7.0",
    "vision-camera-resize-plugin": "^3.1.0"
  },
  "overrides": {
    "react-native": "$react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
