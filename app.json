{
  "expo": {
    "name": "SerbiSure",
    "slug": "serbisure-frontend",
    "version": "2.1.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/serbisure-icon.png",
    "splash": {
      "image": "./assets/serbisure-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "SerbiSure needs camera access for liveness detection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SerbiSure needs access to your photos to upload documents.",
          "cameraPermission": "SerbiSure needs camera access to take document photos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.serbisure.frontend",
      "infoPlist": {
        "NSCameraUsageDescription": "SerbiSure needs camera access for liveness detection."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/serbisure-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.serbisure.frontend",
      "versionCode": 26,
      "runtimeVersion": "2.1.5"
    },
    "owner": "serbisure",
    "extra": {
      "eas": {
        "projectId": "79f64eec-b8ec-4630-9c25-86bc5ac703a3"
      }
    },
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "https://u.expo.dev/79f64eec-b8ec-4630-9c25-86bc5ac703a3"
    }
  }
}
